# ==========================================
# Dinezy Backend Environment Variables Sample
# ==========================================
# Copy this file to `.env` in this directory:
# Windows (PowerShell): Copy-Item .env.sample .env
# Mac/Linux: cp .env.sample .env

# 1. Redis Configuration (Cloud or Local)
REDIS_URL=redis://default:your_redis_password@your_redis_host:14819

# 2. Razorpay Payment Gateway (Test or Live Mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# 3. Security (Optional)
JWT_SECRET_KEY=dinezy-super-secure-secret-key-for-jwt-auth-2026-production
